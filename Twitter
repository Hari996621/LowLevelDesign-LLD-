import java.util.*;

// ─── base class for any user in any platform ─────────────────
abstract class BasicUser {
    int userId;
    String userName;

    public BasicUser(int userId, String userName) {
        this.userId   = userId;
        this.userName = userName;
    }
}

// ─── Twitter specific user with extra profile data ────────────
class User extends BasicUser {
    int likes          = 0;
    String Bio;
    int followersCount = 0;
    int followeesCount = 0;
    int totalTweets    = 0;

    public User(int userId, String userName, String Bio) {
        super(userId, userName);
        this.Bio = Bio;
    }

    // show user profile nicely when printed
    @Override
    public String toString() {
        return "userId: "          + userId +
               " | name: "        + userName +
               " | bio: "         + Bio +
               " | likes: "       + likes +
               " | followers: "   + followersCount +
               " | following: "   + followeesCount +
               " | totalTweets: " + totalTweets;
    }
}

// ─── common follow/unfollow logic for any social platform ────
abstract class Subscribers {
    // who follows whom: userId → set of people they follow
    HashMap<Integer, Set<Integer>> storeSubscribers;

    public Subscribers() {
        this.storeSubscribers = new HashMap<>();
    }

    public void follow(int followerId, int followeeId) {
        // cannot follow yourself
        if(followerId == followeeId) return;

        // create empty set if first time following someone
        if(!storeSubscribers.containsKey(followerId)) {
            storeSubscribers.put(followerId, new HashSet<>());
        }
        storeSubscribers.get(followerId).add(followeeId);
        System.out.println("Followed successfully!");
    }

    public void unfollow(int followerId, int followeeId) {
        if(storeSubscribers.containsKey(followerId)) {
            storeSubscribers.get(followerId).remove(followeeId);
            System.out.println("Unfollowed successfully!");
        }
    }
}

// ─── base class for any content — tweet, post, video ──────────
abstract class Content {
    int like      = 0;
    int timeStamp = 0;

    public Content(int timeStamp) {
        this.timeStamp = timeStamp;
    }

    public void like()   { like++; }
    public void unlike() { if(like > 0) like--; }
}

// ─── a single tweet — extends Content for common fields ───────
class Tweet extends Content {
    int    userId;
    int    tweetId;
    String content;

    public Tweet(int userId, int tweetId, String content, int timeStamp) {
        super(timeStamp);  // sends timeStamp to Content
        this.userId  = userId;
        this.tweetId = tweetId;
        this.content = content;
    }

    // full tweet details — for internal use
    @Override
    public String toString() {
        return "tweetId: "    + tweetId +
               " | userId: " + userId +
               " | content: "+ content +
               " | time: "   + timeStamp +
               " | likes: "  + like;
    }

    // public view — hides timestamp and userId for privacy
    public String toPublicString() {
        return "tweetId: " + tweetId +
               " | content: " + content +
               " | likes: " + like;
    }
}

// ─── contract: anything Deletable must implement these ───────
interface Deletable {
    void deleteUser(int userId);
    void deleteTweet(int userId, int tweetId);
}

// ─── main Twitter class — coordinates everything ─────────────
class Twitter extends Subscribers implements Deletable {
    // all users: userId → User object
    HashMap<Integer, User> storeUsers;

    // all tweets: userId → their list of tweets
    HashMap<Integer, ArrayList<Tweet>> storeTweets;

    // global counter — increments with every tweet
    int timeStamp = 0;

    public Twitter() {
        this.storeUsers  = new HashMap<>();
        this.storeTweets = new HashMap<>();
    }

    // create new user and store in map
    public void registerUser(int userId, String userName, String bio) {
        if(!storeUsers.containsKey(userId)) {
            storeUsers.put(userId, new User(userId, userName, bio));
            System.out.println("Profile created successfully!");
        } else {
            System.out.println("User already exists!");
        }
    }

    // return user object — null if not found
    public User getUserProfile(int userId) {
        if(storeUsers.containsKey(userId)) return storeUsers.get(userId);
        return null;
    }

    // create new tweet, increment timestamp, update user counts
    public void postTweet(int userId, int tweetId, String content) {
        if(!storeUsers.containsKey(userId)) {
            System.out.println("User not found!");
            return;
        }
        timeStamp++;
        Tweet tweet = new Tweet(userId, tweetId, content, timeStamp);

        // first tweet? create empty list first
        if(!storeTweets.containsKey(userId)) {
            storeTweets.put(userId, new ArrayList<>());
        }
        storeTweets.get(userId).add(tweet);
        storeUsers.get(userId).totalTweets++;
        System.out.println("Tweeted successfully!");
    }

    // find tweet and increment likes on both tweet and user
    public void like(int userId, int tweetId) {
        if(storeTweets.containsKey(userId)) {
            for(Tweet t : storeTweets.get(userId)) {
                if(t.tweetId == tweetId) {
                    t.like();
                    storeUsers.get(userId).likes++;
                    System.out.println("Liked!");
                    return;
                }
            }
        }
    }

    // decrement likes — never go below 0
    public void unlike(int userId, int tweetId) {
        if(storeTweets.containsKey(userId)) {
            for(Tweet t : storeTweets.get(userId)) {
                if(t.tweetId == tweetId) {
                    t.unlike();
                    if(storeUsers.get(userId).likes > 0)
                        storeUsers.get(userId).likes--;
                    System.out.println("Unliked!");
                    return;
                }
            }
        }
    }

    // override follow to add user existence check + count updates
    @Override
    public void follow(int followerId, int followeeId) {
        if(!storeUsers.containsKey(followerId) ||
           !storeUsers.containsKey(followeeId)) {
            System.out.println("User not found!");
            return;
        }
        // parent handles the actual storing
        super.follow(followerId, followeeId);
        storeUsers.get(followeeId).followersCount++;
        storeUsers.get(followerId).followeesCount++;
    }

    // override unfollow with user check + count updates
    @Override
    public void unfollow(int followerId, int followeeId) {
        if(!storeUsers.containsKey(followerId)) {
            System.out.println("User not found!");
            return;
        }
        super.unfollow(followerId, followeeId);
        storeUsers.get(followeeId).followersCount--;
        storeUsers.get(followerId).followeesCount--;
    }

    // delete a tweet and update user counts
    @Override
    public void deleteTweet(int userId, int tweetId) {
        if(!storeTweets.containsKey(userId)) {
            System.out.println("No tweets found!");
            return;
        }

        // find the tweet first — do not remove inside loop
        Tweet toDelete = null;
        for(Tweet t : storeTweets.get(userId)) {
            if(t.tweetId == tweetId) {
                toDelete = t;
                break;
            }
        }

        if(toDelete != null) {
            storeTweets.get(userId).remove(toDelete);
            storeUsers.get(userId).totalTweets--;
            // subtract likes that this tweet had
            storeUsers.get(userId).likes -= toDelete.like;
            System.out.println("Tweet deleted successfully!");
        } else {
            System.out.println("Tweet not found!");
        }
    }

    @Override
    public void deleteUser(int userId) {
        // to be implemented — cascading delete
    }

    // search tweets by userId — returns all their tweets
    public ArrayList<Tweet> searchTweets(int userId) {
        if(storeTweets.containsKey(userId)) {
            return storeTweets.get(userId);
        }
        return new ArrayList<>();  // empty list — safer than null
    }

    // search tweets by userName — overloaded version
    // finds userId first, then delegates to int version
    public ArrayList<Tweet> searchTweets(String userName) {
        for(User u : storeUsers.values()) {
            if(u.userName.equals(userName)) {
                return searchTweets(u.userId);
            }
        }
        return new ArrayList<>();
    }

    // get top N tweets from user's feed (own + followees)
    // sorted by timestamp — most recent first
    public ArrayList<Integer> getTopTweets(int userId, int count) {
        // max heap — biggest timestamp comes out first
        PriorityQueue<Tweet> pq = new PriorityQueue<>(
            (a, b) -> b.timeStamp - a.timeStamp
        );
        ArrayList<Integer> topResults = new ArrayList<>();

        // add user's own tweets
        if(storeTweets.containsKey(userId)) {
            for(Tweet t : storeTweets.get(userId)) {
                pq.add(t);
            }
        }

        // add tweets from everyone user follows
        if(storeSubscribers.containsKey(userId)) {
            for(int id : storeSubscribers.get(userId)) {
                if(storeTweets.containsKey(id)) {
                    for(Tweet t : storeTweets.get(id)) {
                        pq.add(t);
                    }
                }
            }
        }

        // poll top N tweets
        for(int i = 0; i < count && !pq.isEmpty(); i++) {
            topResults.add(pq.poll().tweetId);
        }

        return topResults;
    }
}

// ─── main — where we test everything ─────────────────────────
public class Main {
    public static void main(String[] args) {
        Twitter twitter = new Twitter();

        // create users
        twitter.registerUser(1, "hari",    "software developer");
        twitter.registerUser(2, "praveen", "singer");
        twitter.registerUser(3, "harshu",  "data analyst");
        twitter.registerUser(4, "chintu",  "mechanical engineer");
        twitter.registerUser(5, "krishna", "app developer");

        // follow each other
        twitter.follow(1, 2);
        twitter.follow(1, 3);

        // post some tweets
        twitter.postTweet(1, 101, "Hello Twitter!");
        twitter.postTweet(2, 102, "Music is life!");
        twitter.postTweet(1, 103, "Learning Java!");

        // like tweet twice
        twitter.like(1, 101);
        twitter.like(1, 101);

        // check profiles
        System.out.println(twitter.getUserProfile(1));
        System.out.println(twitter.getUserProfile(2));

        // unfollow
        twitter.unfollow(1, 2);
        System.out.println(twitter.getUserProfile(1));

        // unlike
        twitter.unlike(1, 101);
        System.out.println(twitter.getUserProfile(1));

        // delete tweet
        twitter.deleteTweet(1, 101);
        System.out.println(twitter.getUserProfile(1));

        // get feed
        ArrayList<Integer> feed = twitter.getTopTweets(1, 10);
        System.out.println("Feed: " + feed);

        // search by userId
        System.out.println("\n--- Search Tweets by userId ---");
        for(Tweet t : twitter.searchTweets(1)) 
            System.out.println(t.toPublicString());

        // search by userName
        System.out.println("\n--- Search Tweets by userName ---");
        for(Tweet t : twitter.searchTweets("hari")) 
            System.out.println(t.toPublicString());
    }
}
